<?xml version="1.0" encoding="utf-8"?>
<!--
    DEBUG BUILDS ONLY. Overrides the empty default in src/main/res/values/api.xml.

    `localhost` rather than the emulator's 10.0.2.2 host alias, for two reasons:

      1. The WebView page is https://localhost, so calling http://10.0.2.2 is mixed
         content and Chromium blocks it. http://localhost is a "potentially
         trustworthy" origin, so it is exempt. Confirmed by watching the WebView
         refuse 10.0.2.2 and then accept localhost.
      2. `adb reverse tcp:8000 tcp:8000` makes the device's localhost:8000 the host's,
         which works over USB on a real phone too, not only on the emulator.

    The dev loop is written out in android/README.md.

    A release build has no override here and must be configured deliberately.
-->
<resources>
    <string name="api_base_url" translatable="false">http://localhost:8000</string>
</resources>
