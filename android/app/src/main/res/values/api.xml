<?xml version="1.0" encoding="utf-8"?>
<!--
    Where the product API lives, for the NATIVE side.

    The WebView origin is https://localhost, so a relative /api/v1 path would resolve
    against the bundled assets. Both halves of the app need the absolute origin, and
    they must agree:

        this file            -> the scanner's own calls (identifiers, observations)
        VITE_API_BASE        -> the WebView's calls, baked in at `npm run build`

    Leave it empty and the plugin reports `supported: false` rather than scanning into
    a server that is not there.
-->
<resources>
    <string name="api_base_url" translatable="false"></string>
</resources>
