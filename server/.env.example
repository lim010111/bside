# https://localhost is the Capacitor WebView origin, not a browser address. Drop it
# and the Android app fails CORS preflight against a deployed server.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","https://localhost"]
REDIS_URL=redis://127.0.0.1:6379/0

# AI 추천. 셋 다 있어야 평가가 시작되고, 비워 두면 추천 상태가 'unavailable'이 될
# 뿐 서버는 정상 기동한다(server/docs/ai.md). compose가 이 파일을 읽어 컨테이너에
# 넘긴다. 실제 키는 커밋하지 않는 server/.env에만 둔다.
AI_API_KEY=
AI_BASE_URL=https://ai.cs.kookmin.ac.kr/v1
AI_MODEL=claude-haiku-4-5
